{
    "name": "stafast.net",
    "type": "module",
    "version": "2.0.0",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,astro,css}\"",
        "check-types": "tsc --noEmit",
        "clean": "rm -rf .astro",
        "clean:node_modules": "rm -rf .astro node_modules"
