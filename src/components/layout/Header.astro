---
import { navigation } from "@data/constants";
import { Menu } from "@lucide/astro";
import StafastLogo from "@components/icons/StafastLogo.astro";
---

<header class="group/header mb-16 border-b lg:border-none">
    <div class="container mx-auto flex h-20 items-center justify-between">
        <div class="class">
            <a href="/" title="Zur Startseite">
                <StafastLogo class="text-foreground h-7 w-auto" />
            </a>
        </div>
        <nav class="class relative">
            <div class="lg:hidden">
                <Menu class="size-6" />
            </div>
            <ul class="navigation-items hidden items-center gap-8 lg:flex">
                {
                    navigation.map((item) => (
                        <li>
                            <a
                                href={item.url}
                                class="text-foreground/80 hover:text-foreground transition"
                            >
                                {item.title}
                            </a>
                        </li>
                    ))
                }
            </ul>
            <div class=""></div>
        </nav>
    </div>
</header>
