---
import stafastConfig from "../../../stafast.config";
import StafastLogo from "@components/icons/StafastLogo.astro";
import SocialLink from "@components/icons/social/SocialLink.astro";
---

<footer
    class="relative overflow-hidden pt-24 pb-16 after:absolute after:right-[-20%] after:bottom-[-40%] after:-z-1 after:h-full after:w-full after:bg-[radial-gradient(oklch(0.905_0.045_167.933/0.3),transparent_60%)] after:content-['']"
>
    <div class="container space-y-12 md:space-y-24">
        <div
            class="grid grid-cols-2 gap-12 md:grid-cols-3 lg:gap-8 xl:grid-cols-5"
        >
            <div
                class="md:max-w-auto col-span-2 mb-6 sm:mx-auto sm:max-w-lg sm:text-center md:col-span-3 xl:col-span-2 xl:mx-0 xl:mb-0 xl:text-start"
            >
                <a href="/">
                    <StafastLogo class="mb-3 inline-block h-6 text-black" />
                </a>
                <p class="mb-5">
                    Software Engineer aus Kiel mit Schwerpunkt Frontend. Ich
                    entwickle digitale Produkte mit technischer Tiefe, klarer
                    Struktur und einem pragmatischen Blick auf reale
                    Anforderungen.
                </p>
                <ul class="flex space-x-6 sm:justify-center xl:justify-start">
                    {
                        stafastConfig.social.map((social) => (
                            <li class="flex justify-center">
                                <SocialLink
                                    iconClass="size-7 hover:text-primary"
                                    url={social.url}
                                    platform={social.platform}
                                />
                            </li>
                        ))
                    }
                </ul>
            </div>

            {
                stafastConfig.footerMenu.map((footerMenuBlock) => (
                    <div aria-label={footerMenuBlock.title}>
                        <h5 class="mb-4">{footerMenuBlock.title}</h5>
                        <ul class="space-y-2">
                            {footerMenuBlock.items.map((item) => (
                                <li>
                                    <a href={item.url}>{item.title}</a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>

        <div
            class="flex flex-col gap-1 text-sm md:flex-row md:justify-between [&_a]:font-medium [&_a]:hover:underline"
        >
            <span class="">
                &copy; {new Date().getFullYear()}
                <span class="font-serif text-base font-semibold">stafast</span>.
                Alle Rechte vorbehalten.
            </span>
            <span>
                Built with <a
                    target="_blank"
                    rel="noopener noreferrer"
                    href="https://astro.build">Astro</a
                > and hosted on <a href="/blog/edge-computing-einfach-erklaert/"
                    >Edge Computing</a
                >.
            </span>
        </div>
    </div>
</footer>
<style>
    footer::after {
        animation: footer-move 8s cubic-bezier(0.65, 0.05, 0.36, 1) infinite;
    }

    @keyframes footer-move {
        0%,
        100% {
            right: -20%;
        }
        50% {
            right: 20%;
        }
    }
</style>
