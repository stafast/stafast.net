---
import SocialLink from "@components/icons/social/SocialLink.astro";
const props = Astro.site;
---

<footer>
    <div class="container space-y-4 py-8">
        <div class="">
            <nav aria-label="Social media">
                <ul class="flex gap-6">

                            <li>
                                <SocialLink
                                    class="text-secondary"
                                    iconClass="size-6"
                                    label="LinkedIn"
                                    platform="linkedin"
                                    url="https://www.linkedin.com/in/linked-in/"
                                />
                            </li>

                </ul>
            </nav>
        </div>
        <div class="">
            Copyright © {new Date().getFullYear()}
            {props}. All Rights Reserved.
        </div>
    </div>
</footer>
