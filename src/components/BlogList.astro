---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { toSlug } from "@lib/toSlug.ts";

interface Props {
    posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

<ol class="grid gap-x-8 gap-y-12 md:grid-cols-2 md:gap-y-14 xl:grid-cols-3">
    {
        posts.map((post) => {
            const primaryTag = post.data.tags[0];

            return (
                <li>
                    <article class="group">
                        {post.data.teaser && (
                            <a
                                class="bg-tertiary block overflow-hidden rounded-xl no-underline"
                                data-astro-prefetch
                                href={`/blog/${post.id}/`}
                                aria-label={post.data.title}
                            >
                                <Image
                                    class="aspect-video w-full object-cover shadow-sm transition-transform duration-300 group-hover:scale-[1.015] motion-reduce:transition-none"
                                    format="webp"
                                    loading="lazy"
                                    decoding="async"
                                    width={640}
                                    densities={[1, 1.5, 2]}
                                    src={post.data.teaser}
                                    alt={post.data.teaserAlt}
                                />
                            </a>
                        )}

                        <div class:list={[{ "mt-5": post.data.teaser }]}>
                            <div class="text-foreground/50 text-eyebrow mb-3 flex min-w-0 items-center gap-x-2">
                                {primaryTag && (
                                    <>
                                        <a
                                            class="hover:text-primary truncate transition-colors"
                                            href={`/blog/tags/${toSlug(primaryTag)}/`}
                                            aria-label={`Thema: ${primaryTag}`}
                                        >
                                            {primaryTag}
                                        </a>
                                        <span
                                            class="shrink-0"
                                            aria-hidden="true"
                                        >
                                            •
                                        </span>
                                    </>
                                )}
                                <time
                                    class="shrink-0"
                                    datetime={post.data.published.toISOString()}
                                >
                                    {post.data.published.toLocaleDateString(
                                        "de-DE",
                                        {
                                            dateStyle: "long",
                                        },
                                    )}
                                </time>
                            </div>

                            <h2 class="line-clamp-2 text-xl leading-snug font-semibold tracking-tight md:min-h-14">
                                <a
                                    class="hover:text-primary no-underline transition-colors"
                                    data-astro-prefetch
                                    href={`/blog/${post.id}/`}
                                >
                                    {post.data.title}
                                </a>
                            </h2>
                            <p class="text-foreground/70 mt-3 line-clamp-3 text-base leading-relaxed">
                                {post.data.description}
                            </p>
                        </div>
                    </article>
                </li>
            );
        })
    }
</ol>
