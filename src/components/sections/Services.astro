---
import { Image } from "astro:assets";
import { CodeXml, FolderKanban, Layers } from "@lucide/astro";
import meImage from "@/assets/images/me.jpg";
import Button from "@components/ui/Button.astro";
---

<section id="hero">
    <div class="container">
        <div
            class="grid gap-12 lg:grid-cols-[3fr_2fr] lg:items-start lg:gap-16 xl:gap-32"
        >
            <div>
                <span class="text-eyebrow mb-2 inline-block">
                    <span aria-hidden="true">//</span>
                    <span class="role-title print:hidden" aria-hidden="true"
                        >SOFTWARE ENGINEER</span
                    >
                    <span class="sr-only">
                        Schwerpunkte: Software Engineering, Full-Stack
                        Experience, Technical Conception sowie Festivals und
                        digitale Erlebnisse.
                    </span>
                    <span class="hidden print:!inline">SOFTWARE ENGINEER</span>
                    <span class="" aria-hidden="true">·</span>
                    <span class="" aria-label="Standort">Kiel</span></span
                >

                <h1 class="text-display">
                    Softwareentwicklung mit technischer Tiefe.
                </h1>
                <p class="text-lead mt-4">
                    Ich entwickle komplexe digitale Produkte und verbinde
                    technische Tiefe mit klarer Struktur, guter Benutzerführung
                    und langfristig wartbaren Lösungen.
                </p>
                <div class="mt-8 flex flex-wrap gap-6">
                    <Button>Erfahrung ansehen</Button>
                    <Button variant="link">Lass uns reden &#8594;</Button>
                </div>
                <div class="hidden">
                    <ul
                        class="[&>li>svg]:text-primary flex flex-wrap gap-6 text-sm font-medium [&>li]:flex [&>li]:items-center [&>li]:gap-2.5 [&>li]:py-2 [&>li]:pr-6 [&>li:not(:last-child)]:border-r [&>li>svg]:size-6"
                    >
                        <li><CodeXml /> Softwareentwicklung</li>
                        <li><Layers /> Technische Konzeption</li>
                        <li><FolderKanban /> Projektverantwortung</li>
                    </ul>
                </div>
            </div>
            <div class="relative aspect-10/8 overflow-hidden lg:aspect-9/10">
                <div
                    class="absolute inset-0 -z-10 animate-pulse rounded-lg bg-neutral-200"
                >
                </div>
                <Image
                    src={meImage}
                    alt="Porträt von André Stafast"
                    width="1000"
                    height="1109"
                    decoding="async"
                    fetchpriority="high"
                    class="h-full w-full rounded-lg object-cover object-[center_40%] shadow"
                />
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";

    const roleTitle = document.querySelector<HTMLElement>(".role-title");
    const roles = [
        "SOFTWARE ENGINEERING",
        "FULL-STACK EXPERIENCE",
        "TECHNICAL CONCEPTION",
        "FESTIVALS & DIGITAL EXPERIENCES",
    ];

    if (roleTitle) {
        const timeline = gsap.timeline({ repeat: -1 });

        for (const role of roles) {
            const characters = { count: 0 };

            timeline
                .to(characters, {
                    count: role.length,
                    duration: role.length * 0.06,
                    ease: "none",
                    snap: { count: 1 },
                    onUpdate: () => {
                        roleTitle.textContent = role.slice(0, characters.count);
                    },
                })
                .to({}, { duration: 3 })
                .to(characters, {
                    count: 0,
                    duration: role.length * 0.045,
                    ease: "none",
                    snap: { count: 1 },
                    onUpdate: () => {
                        roleTitle.textContent = role.slice(0, characters.count);
                    },
                })
                .to({}, { duration: 0.3 });
        }
    }
</script>

<style>
    .role-title::after {
        width: 0.08em;
        height: 0.9em;
        margin-left: 0.12em;
        display: inline-block;
        background: currentColor;
        content: "";
        vertical-align: -0.08em;
        animation: role-title-cursor 1s steps(1, end) infinite;
    }

    @keyframes role-title-cursor {
        50% {
            opacity: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .role-title::after {
            display: none;
        }
    }
</style>
