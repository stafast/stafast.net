---
import { services } from "@data/webdevelopment.ts";
---

<section id="angebot" class="bg-neutral-900 py-24 md:py-42">
    <div class="container">
        <div class="max-w-3xl">
            <h2 id="angebot-heading" class="h1">
                {services.title}
            </h2>
        </div>
        <div class="mt-12 grid gap-10 lg:mt-16 lg:grid-cols-3 lg:gap-16">
            {services.items.map((service) => (
                <div>
                    <h3 class="h4">{service.title}</h3>
                    <p class="mt-4">{service.description}</p>
                    <ul class="marker:text-accent mt-6 list-[square] space-y-2 pl-5 text-sm">
                        {service.examples.map((item) => (
                            <li>{item}</li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </div>
</section>
