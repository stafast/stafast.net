---
import { process } from "@data/webdevelopment.ts";
---

<section
    id="zusammenarbeit"
    aria-labelledby="zusammenarbeit-heading"
    class="container"
>
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-24">
        <div>
            <h2 id="zusammenarbeit-heading" class="h3">
                {process.title}
            </h2>
        </div>
        <div class="min-w-0 lg:col-span-2">
            <ol class="space-y-8">
                {process.items.map((step, index) => (
                    <li>
                        <div>
                            <h3 class="h4">
                                {index + 1}. {step.title}
                            </h3>
                            <p class="mt-3">{step.description}</p>
                        </div>
                    </li>
                ))}
            </ol>
            <div class="bg-secondary mt-10 rounded-lg p-6 sm:p-8">
                <h3 class="h5">{process.collaboration.title}</h3>
                {process.collaboration.paragraphs.map((paragraph, index) => (
                    <p class={index === 0 ? "mt-3" : "mt-4"}>{paragraph}</p>
                ))}
            </div>
        </div>
    </div>
</section>
