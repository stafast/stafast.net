---
import { Image } from "astro:assets";
import festivalImage from "@data/blog/website-entwickler-head-of-artists-love-explosion/teaser.jpg";
import { experience } from "@data/events.ts";
import Button from "@components/ui/Button.astro";
---

<section id="erfahrung" aria-labelledby="erfahrung-heading" class="container">
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-24">
        <div>
            <p class="text-eyebrow mb-3">{experience.eyebrow}</p>
            <h2 id="erfahrung-heading" class="h3 hyphens-auto">
                {experience.title}
            </h2>
        </div>
        <div class="min-w-0 lg:col-span-2">
            <p class="text-lead">{experience.introduction}</p>
            <p class="mt-6">{experience.description}</p>
            <figure class="mt-8">
                <Image
                    src={festivalImage}
                    alt={experience.image.alt}
                    width={1200}
                    widths={[480, 800, 1200, 1600]}
                    sizes="(min-width: 1344px) 800px, (min-width: 1024px) 65vw, calc(100vw - 2rem)"
                    loading="lazy"
                    class="aspect-video w-full rounded-lg object-cover"
                />
                <figcaption class="text-muted-foreground mt-2 text-sm">
                    {experience.image.caption}
                </figcaption>
            </figure>
            <dl class="mt-8 divide-y border-y">
                {experience.details.map((detail) => (
                    <div class="grid gap-3 py-6 sm:grid-cols-[10rem_1fr] sm:gap-8">
                        <dt class="font-medium hyphens-auto">{detail.title}</dt>
                        <dd>
                            <p>{detail.description}</p>
                        </dd>
                    </div>
                ))}
            </dl>
            <Button
                href={experience.link.url}
                variant="link"
                class="mt-6 h-auto whitespace-normal px-0 text-left"
            >
                {experience.link.label}
            </Button>
        </div>
    </div>
</section>
