---
import { Image } from "astro:assets";
import { CodeXml, FolderKanban, Layers } from "@lucide/astro";
import meImage from "@/assets/images/me.jpg";
import Button from "@components/ui/Button.astro";
import { hero } from "@data/home.ts";
---

<section id="hero">
    <div class="container">
        <div
            class="grid gap-12 lg:grid-cols-[3fr_2fr] lg:items-start lg:gap-16 xl:gap-32"
        >
            <div>
                <span class="text-eyebrow mb-2">
                    <span aria-hidden="true">//</span>
                    <span class="role-title print:hidden" aria-hidden="true"
                        >{hero.eyebrow.roleDefault}</span
                    >
                    <span class="sr-only">{hero.eyebrow.screenReader}</span>
                    <span class="hidden print:inline!"
                        >{hero.eyebrow.roleDefault}</span
                    >
                    <span class="" aria-hidden="true">·</span>
                    <span class="" aria-label="Standort"
                        >{hero.eyebrow.city}</span
                    ></span
                >

                <h1 class="text-display">{hero.heading}</h1>
                <p class="text-lead mt-4">{hero.description}</p>
                <div class="mt-8 flex flex-wrap gap-6">
                    <Button href={hero.cta.primary.url}>
                        {hero.cta.primary.label}
                    </Button>
                    <Button href={hero.cta.secondary.url} variant="link">
                        {hero.cta.secondary.label} &#8594;
                    </Button>
                </div>
                <div class="hidden">
                    <ul
                        class="[&>li>svg]:text-primary flex flex-wrap gap-6 text-sm font-medium [&>li]:flex [&>li]:items-center [&>li]:gap-2.5 [&>li]:py-2 [&>li]:pr-6 [&>li:not(:last-child)]:border-r [&>li>svg]:size-6"
                    >
                        <li><CodeXml /> Softwareentwicklung</li>
                        <li><Layers /> Technische Konzeption</li>
                        <li><FolderKanban /> Projektverantwortung</li>
                    </ul>
                </div>
            </div>
            <div class="relative aspect-10/8 overflow-hidden lg:aspect-9/10">
                <div class="skeleton absolute inset-0 -z-10"></div>
                <Image
                    src={meImage}
                    alt="Porträt von André Stafast"
                    width="1000"
                    height="1109"
                    decoding="async"
                    fetchpriority="high"
                    class="h-full w-full object-cover object-[center_40%] shadow"
                />
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { hero } from "@data/home";

    const roleTitle = document.querySelector<HTMLElement>(".role-title");
    const roles = hero.eyebrow.roles;

    if (roleTitle) {
        const timeline = gsap.timeline({ repeat: -1 });

        for (const role of roles) {
            const characters = { count: 0 };

            timeline
                .to(characters, {
                    count: role.length,
                    duration: role.length * 0.06,
                    ease: "none",
                    snap: { count: 1 },
                    onUpdate: () => {
                        roleTitle.textContent = role.slice(0, characters.count);
                    },
                })
                .to({}, { duration: 3 })
                .to(characters, {
                    count: 0,
                    duration: role.length * 0.045,
                    ease: "none",
                    snap: { count: 1 },
                    onUpdate: () => {
                        roleTitle.textContent = role.slice(0, characters.count);
                    },
                })
                .to({}, { duration: 0.3 });
        }
    }
</script>

<style>
    .role-title::after {
        width: 0.08em;
        height: 0.9em;
        margin-left: 0.12em;
        display: inline-block;
        background: currentColor;
        content: "";
        vertical-align: -0.08em;
        animation: role-title-cursor 1s steps(1, end) infinite;
    }

    @keyframes role-title-cursor {
        50% {
            opacity: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .role-title::after {
            display: none;
        }
    }
</style>
