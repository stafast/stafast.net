---
import { experience } from "@data/work.ts";
import Button from "@components/ui/Button.astro";
---

<section id="work-experiences">
    {experience.map((section) => (
        <div class="group even:bg-neutral-900 md:py-42 py-24">
            <div class="container grid gap-10 lg:grid-cols-3 lg:gap-24">
                <div>
                    <h2
                        id={section.id}
                        class="h3 hyphens-auto group-even:text-neutral-50"
                    >
                        {section.title}
                    </h2>
                    <p class="mt-2">{section.description}</p>
                </div>
                <div class="space-y-12 lg:col-span-2">
                    {section.entries.map((entry) => (
                        <div>
                            <div class="mb-4">
                                <p class="text-eyebrow group-even:text-accent">
                                    {entry.period}
                                </p>
                                <h3
                                    id={entry.id}
                                    class="h4 mt-2 group-even:text-neutral-50"
                                >
                                    {entry.organization}
                                </h3>
                                <span class="mt-1">{entry.role}</span>
                            </div>
                            <p>{entry.description}</p>
                            <ul
                                class="marker:text-primary mt-4 space-y-2 pl-5 group-even:marker:text-accent"
                                style="list-style-type: square;"
                            >
                                {entry.highlights.map((highlight) => (
                                    <li>{highlight}</li>
                                ))}
                            </ul>
                            {entry.id === "andre-stafast" && (
                                <div class="mt-12">
                                    <span class="me-2 font-medium">
                                        Leistungsangebote:{" "}
                                    </span>
                                    <Button size="sm" href="/webentwicklung/">
                                        Webentwicklung
                                    </Button>
                                </div>
                            )}
                            {entry.links && (
                                <p class="mt-4 hidden">
                                    <span class="font-medium">Auswahl:</span>
                                    {entry.links?.map((link) => (
                                        <a
                                            class="inline-flex items-center text-primary hover:text-primary/80 not-last:after:content-[','] pe-2"
                                            href={link.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            {link.title}
                                        </a>
                                    ))}
                                </p>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </div>
    ))}
</section>
