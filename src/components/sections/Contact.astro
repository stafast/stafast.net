---
import Button from "@components/ui/Button.astro";
import { contact } from "@data/webdevelopment.ts";
---

<section id="projekt-anfragen" class="container">
    <div class="grid gap-6 lg:grid-cols-3 lg:gap-24">
        <div>
            <h2 id="contact-heading" class="h3">
                {contact.title}
            </h2>
        </div>
        <div class="lg:col-span-2">
            <p>{contact.description}</p>
            <Button href={contact.link.url} class="mt-6">
                {contact.link.label}
            </Button>
        </div>
    </div>
</section>
