---
import "@fontsource-variable/geist-mono/wght.css";
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/bricolage-grotesque/wght.css";
import "@/styles/global.css";
import bricolageGrotesque from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import geistMono from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import geist from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import Cursor from "@components/layout/Cursor.astro";
import stafastConfig from "../../stafast.config";
import { SEO } from "astro-seo";

interface Props {
    title?: string;
    description?: string;
    noindex?: boolean;
}

const {
    title,
    description = stafastConfig.seo.description,
    noindex = false,
} = Astro.props;

const pageTitle = title
    ? stafastConfig.seo.titleTemplate.replace("%s", title)
    : stafastConfig.seo.title;

const openGraphImage = new URL(
    stafastConfig.seo.defaultImage,
    stafastConfig.site.url,
).toString();
---

<html lang={stafastConfig.site.language} class="scroll-smooth">
    <head>
        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href={bricolageGrotesque}
            crossorigin="anonymous"
        />
        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href={geist}
            crossorigin="anonymous"
        />
        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href={geistMono}
            crossorigin="anonymous"
        />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#f5f7f5" />
        <SEO
            title={pageTitle}
            description={description}
            charset="utf-8"
            noindex={noindex}
            nofollow={noindex}
            openGraph={{
                basic: {
                    title: pageTitle,
                    type: "website",
                    image: openGraphImage,
                },
                optional: {
                    description,
                    locale: stafastConfig.site.locale,
                    siteName: stafastConfig.site.name,
                },
            }}
            twitter={{ card: "summary_large_image" }}
        />
    </head>
    <body>
        <Header />
        <main class="flex-1">
            <slot />
        </main>
        <Footer />
        <Cursor />
    </body>
</html>
