---
import { Image, getImage } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { toSlug } from "@lib/toSlug.ts";
import stafastConfig from "../../../stafast.config.ts";
import Button from "@components/ui/Button.astro";

interface Props {
    post: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
    const posts = await getCollection("blog", ({ data }) =>
        import.meta.env.PROD ? !data.draft : true,
    );

    return posts.map((post) => ({
        params: { id: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const minutesRead = remarkPluginFrontmatter.minutesRead as string;
const siteUrl = Astro.site ?? new URL(stafastConfig.site.url);
const canonicalUrl =
    post.data.canonicalUrl ?? new URL(`/blog/${post.id}/`, siteUrl).toString();
const ogImage = post.data.teaser
    ? await getImage({
          src: post.data.teaser,
          format: "jpg",
          width: 1200,
          height: 630,
          fit: "cover",
      })
    : undefined;
const imageUrl = ogImage ? new URL(ogImage.src, siteUrl).toString() : undefined;
const wordCount = post.body?.trim()
    ? post.body.trim().split(/\s+/).length
    : undefined;

const structuredData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    url: canonicalUrl,
    mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalUrl,
    },
    inLanguage: stafastConfig.site.language,
    keywords: post.data.tags,
    datePublished: post.data.published.toISOString(),
    dateModified: (post.data.updated ?? post.data.published).toISOString(),
    wordCount,
    ...(imageUrl
        ? {
              image: {
                  "@type": "ImageObject",
                  url: imageUrl,
                  width: 1200,
                  height: 630,
                  caption: post.data.teaserAlt,
              },
          }
        : {}),
    author: {
        "@type": "Person",
        name: stafastConfig.site.name,
        url: stafastConfig.site.url,
    },
};
const serializedStructuredData = JSON.stringify(structuredData).replace(
    /</g,
    "\\u003c",
);
---

<Layout
    title={post.data.title}
    description={post.data.description}
    canonical={canonicalUrl}
    {...ogImage ? { image: ogImage.src } : {}}
    imageAlt={post.data.teaserAlt ?? post.data.title}
    openGraphType="article"
    article={{
        publishedTime: post.data.published.toISOString(),
        ...(post.data.updated
            ? { modifiedTime: post.data.updated.toISOString() }
            : {}),
        tags: post.data.tags,
    }}
>
    <script
        slot="head"
        is:inline
        type="application/ld+json"
        set:html={serializedStructuredData}
    />

    <article class="container">
        <div class="mx-auto max-w-3xl">
            <header class="mb-10">
                <div
                    class="text-foreground/60 mb-5 flex flex-wrap gap-x-3 gap-y-1 text-sm"
                >
                    <span>
                        <time datetime={post.data.published.toISOString()}>
                            {
                                post.data.published.toLocaleDateString(
                                    "de-DE",
                                    {
                                        dateStyle: "long",
                                    },
                                )
                            }
                        </time>
                    </span>
                    <span aria-hidden="true">·</span>
                    <span>{minutesRead}</span>
                </div>

                <h1 class="text-5xl hyphens-auto">
                    {post.data.title}
                </h1>
                <p class="text-lead mt-4">{post.data.description}</p>

                {
                    post.data.teaser && (
                        <Image
                            class="transition-name-blog-image bg-tertiary mt-6 aspect-video w-full object-cover"
                            style={`view-transition-name: blog-post-image-${post.id}`}
                            format="webp"
                            loading="eager"
                            decoding="async"
                            fetchpriority="high"
                            widths={[640, 960, 1280]}
                            sizes="(max-width: 768px) calc(100vw - 2rem), 768px"
                            src={post.data.teaser}
                            alt={post.data.teaserAlt}
                        />
                    )
                }

                {
                    post.data.updated && (
                        <div class="text-muted-foreground mt-5 text-sm italic">
                            <span>
                                Aktualisiert am{" "}
                                <time
                                    datetime={post.data.updated.toISOString()}
                                >
                                    {post.data.updated.toLocaleDateString(
                                        "de-DE",
                                        {
                                            dateStyle: "long",
                                        },
                                    )}
                                </time>
                            </span>
                        </div>
                    )
                }
            </header>

            <div
                class="prose prose-lg prose-neutral prose-a:text-primary max-w-none"
            >
                <Content />
            </div>

            <ul class="mt-12 flex flex-wrap gap-4" aria-label="Themen">
                {
                    post.data.tags.map((tag) => (
                        <li>
                            <Button
                                variant="secondary"
                                class="rounded-full"
                                size="sm"
                                href={`/blog/tags/${toSlug(tag)}/`}
                            >
                                {tag}
                            </Button>
                        </li>
                    ))
                }
            </ul>

            <p class="mt-12">
                <a href="/blog/">&larr; Zurück zum Blog</a>
            </p>
        </div>
    </article>
</Layout>
