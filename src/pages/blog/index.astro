---
import Layout from "@layouts/Layout.astro";
import BlogList from "@components/BlogList.astro";
import { getCollection } from "astro:content";
import stafastConfig from "../../../stafast.config.ts";

const posts = (
    await getCollection("blog", ({ data }) =>
        import.meta.env.PROD ? !data.draft : true,
    )
).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<Layout
    title={stafastConfig.blog.title}
    description={stafastConfig.blog.description}
>
    <section class="container py-16 md:py-24">
        <header class="mb-14 max-w-3xl">
            <p class="text-eyebrow mb-4">Gedanken und Erfahrungen</p>
            <h1>{stafastConfig.blog.title}</h1>
            <p class="text-lead mt-6">{stafastConfig.blog.introduction}</p>
        </header>

        <div>
            {
                posts.length > 0 ? (
                    <BlogList posts={posts} />
                ) : (
                    <p>Zurzeit sind keine Blogbeiträge veröffentlicht.</p>
                )
            }

            {
                posts.length > 0 && (
                    <p class="mt-12">
                        <a href="/blog/tags/">Alle Themen im Überblick</a>
                    </p>
                )
            }
        </div>
    </section>
</Layout>
