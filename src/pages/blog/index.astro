---
import Layout from "@layouts/Layout.astro";
import BlogList from "@components/BlogList.astro";
import { getCollection } from "astro:content";
import stafastConfig from "../../../stafast.config.ts";
import Button from "@/components/ui/Button.astro";

const posts = (
    await getCollection("blog", ({ data }) =>
        import.meta.env.PROD ? !data.draft : true,
    )
).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<Layout
    title={stafastConfig.blog.title}
    description={stafastConfig.blog.description}
>
    <section class="container">
        <header class="mb-14">
            <span class="text-eyebrow mb-2">// Alles & nichts</span>
            <h1 class="text-display">{stafastConfig.blog.title}</h1>
            <p class="text-lead mt-4">{stafastConfig.blog.introduction}</p>
        </header>

        <div>
            {
                posts.length > 0 ? (
                    <BlogList posts={posts} />
                ) : (
                    <p>Zurzeit sind keine Blogbeiträge veröffentlicht.</p>
                )
            }

            {
                posts.length > 0 && (
                    <div class="mt-12 text-center">
                        <Button href="/blog/tags/">
                            Alle Themen im Überblick
                        </Button>
                    </div>
                )
            }
        </div>
    </section>
</Layout>
