---
import Layout from "@layouts/Layout.astro";
import BlogList from "@components/BlogList.astro";
import { getBlogPosts } from "@lib/blog";
import stafastConfig from "../../../stafast.config.ts";
import Button from "@/components/ui/Button.astro";

const posts = await getBlogPosts();
---

<Layout
    title="Blog über Software, Festivals und Laufen"
    description={stafastConfig.blog.description}
>
    <section class="container">
        <header class="mb-14">
            <span class="text-eyebrow mb-2">// Alles & nichts</span>
            <h1 class="text-display">{stafastConfig.blog.title}</h1>
            <p class="text-lead mt-4">{stafastConfig.blog.introduction}</p>
        </header>

        <div>
            {posts.length > 0 ? (
                <BlogList posts={posts} />
            ) : (
                <p>Zurzeit sind keine Blogbeiträge veröffentlicht.</p>
            )}

            {posts.length > 0 && (
                <div class="mt-12 text-center">
                    <Button href="/blog/tags/">Alle Themen im Überblick</Button>
                </div>
            )}
        </div>
    </section>
</Layout>
